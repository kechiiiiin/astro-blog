---
import BaseLayout from './BaseLayout.astro'
import PostDate from '../components/PostDate.astro'
import ArticleContent from '../components/ArticleContent.astro';
import type { UnifiedEmonicleEntry } from '../lib/content'

interface Props {
  post: UnifiedEmonicleEntry
  preview?: boolean
}

const { post, preview = false } = Astro.props

// Safety check for post and post.data
if (!post || !post.data) {
  throw new Error('Post or post.data is undefined in EmoniclePost layout');
}

const { title, date, image } = post.data
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout title={title} description={post.data.description} image={image} ogType="article" noindex={preview}>
  <article>
    {preview && (
      <div class="preview-note">
        下書きプレビュー — このページは一覧・RSS・検索には表示されません
      </div>
    )}
    <a class="back-btn" href="/emonicle/">‹ 一覧へ戻る</a>
    <p class="article-meta"><PostDate date={date} /></p>
    <h1 class="page-title">{title}</h1>
    {image && <img src={image} alt={title} class="article-hero" loading="eager" />}
    <ArticleContent class="article-body" url={canonicalURL.href} title={title}>
      <slot />
    </ArticleContent>
  </article>
</BaseLayout>
