---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import LegacyHeader from '../components/heisei/LegacyHeader.astro'
import LegacyFooter from '../components/heisei/LegacyFooter.astro'
import { GoogleAnalytics } from 'astro-google-analytics'
import { siteConfig } from '../config'
import '../styles/site.css'

interface Props {
  title: string
  description?: string
  image?: string
  ogType?: string
  noindex?: boolean
}

const { title, description = siteConfig.description, image, ogType = 'website', noindex = false } = Astro.props
// 既定の OGP 画像は正方形（og-square.png・800x800・白地にアイコン）。
// X は summary 型カード（左に正方形サムネ＋右にタイトル・説明）。summary_large_image だと
// 画像が全面に出て Keisuke のイメージと違った（2026-09-04）。横長版は不要とのことで廃止。
const ogImage = image ?? `${siteConfig.site}og-square.png`
const currentUrl = Astro.url.href

// 平成ページ（/heisei・平成風の隠しページ）は 2026-09 リニューアルの対象外で、
// ヘッダー・フッター・幅も含めて旧レイアウトのまま出す（src/components/heisei/ に旧部品を退避）。
const isHeisei = Astro.url.pathname.replace(/\/$/, '') === '/heisei'
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta property="twitter:url" content={currentUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Twitter Widget JavaScript -->
    <script async src="https://platform.twitter.com/widgets.js"></script>

    {siteConfig.googleAnalysis && <GoogleAnalytics id={siteConfig.googleAnalysis} />}
  </head>
  <body class={isHeisei ? 'min-h-screen bg-white' : 'katachi'}>
    {isHeisei && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <LegacyHeader />
      </div>
    )}
    {isHeisei && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <main class="py-12">
          <slot />
        </main>
      </div>
    )}
    {isHeisei && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <LegacyFooter />
      </div>
    )}
    {!isHeisei && <Header />}
    {!isHeisei && (
      <main class="site-main">
        <div class="frame">
          <slot />
        </div>
      </main>
    )}
    {!isHeisei && <Footer />}
  </body>
</html>
