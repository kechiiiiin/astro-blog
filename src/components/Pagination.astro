---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;
---

{totalPages > 1 && (
  <nav class="pager" aria-label="ページ送り">
    {currentPage > 1 && (
      <a href={currentPage === 2 ? baseUrl : `${baseUrl}${currentPage - 1}`}>‹ 新しい記事</a>
    )}
    <span class="pager-count">{currentPage} / {totalPages}</span>
    {currentPage < totalPages && (
      <a class="pager-next" href={`${baseUrl}${currentPage + 1}`}>古い記事 ›</a>
    )}
  </nav>
)}
