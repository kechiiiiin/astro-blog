---
interface Props {
  tags: string[];
  /** chip = 記事の頭の枠付きタグ／inline = 一覧の行の右に「・」区切りで並べる */
  variant?: 'chip' | 'inline';
}

const { tags, variant = 'chip' } = Astro.props;
---

{variant === 'chip' ? (
  <div class="article-tags">
    {tags.map((tag) => (
      <a href={`/tags/${tag}`} class="tag-chip">{tag}</a>
    ))}
  </div>
) : (
  <span class="day-tags">
    {tags.map((tag, i) => (
      <>{i > 0 && '・'}<a href={`/tags/${tag}`}>{tag}</a></>
    ))}
  </span>
)}
