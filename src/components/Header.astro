---
import { Image } from 'astro:assets';
import { siteConfig } from '../config';
import Search from './Search.astro';
import siteIconSource from '../assets/icons/site-icon-source.png';

const navItems = [
  { href: '/diary', text: 'Diary', match: ['/diary'] },
  { href: '/blog', text: 'Blog', match: ['/blog', '/tags', '/archive'] },
  { href: '/podcasts', text: 'Podcast', match: ['/podcasts'] },
  { href: '/profile', text: 'Profile', match: ['/profile'] },
];

const path = Astro.url.pathname;
const isActive = (match: string[]) =>
  match.some((m) => path === m || path.startsWith(`${m}/`));
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <Image src={siteIconSource} alt="" width={56} height={56} format="webp" />
      {siteConfig.title}
    </a>
    <nav class="tabnav" aria-label="サイト内">
      {navItems.map(({ href, text, match }) => (
        <a href={href} aria-current={isActive(match) ? 'page' : undefined}>{text}</a>
      ))}
    </nav>
    {siteConfig.search && <div class="header-search"><Search /></div>}
  </div>
</header>
