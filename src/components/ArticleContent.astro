---
import HatenaStar from './HatenaStar.astro';

interface Props {
  class?: string;
  url: string;
  title: string;
}

// 本文の器。prose（Tailwind Typography）は余白・リストなどの骨組みにだけ使い、
// 色は tailwind.config.mjs の typography でサイトのトークン（墨）に寄せてある。
// ブログ等は class="article-body"（src/styles/site.css）、日記は class="diary-content"（DiaryPost.astro）で組版を載せる。
// リンクカード（.link-card*）の見た目は site.css に移した。
const { class: className = '', url, title } = Astro.props;
---

<div class:list={['prose prose-lg max-w-none', className]}>
  <slot />
  <HatenaStar url={url} title={title} />
</div>

<style>
  /* Astro 既定の shiki（.astro-code）が来ても地はトークンの下地に */
  :global(.astro-code) {
    background-color: var(--soft) !important;
    color: var(--fg) !important;
  }
</style>
