<button id="search-button" class="search-button" aria-label="Search">
  <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<div id="search-modal" class="search-modal hidden" role="dialog" aria-modal="true" aria-label="サイト内検索">
  <div class="search-panel">
    <button id="close-search" class="search-close" aria-label="Close search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <input type="text" id="search-input" class="search-input" placeholder="日記・ブログを検索" autocomplete="off" />
    <div id="search-results" class="search-results">
      <div class="search-empty">見つかりませんでした</div>
    </div>
  </div>
</div>

<style is:global>
  /* 検索（ヘッダーのアイコン＋モーダル）。見た目は site.css のトークンに合わせる */
  .search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    color: var(--muted);
    padding: 6px 8px;
    cursor: pointer;
  }
  .search-button:hover {
    color: var(--fg);
  }
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: rgba(26, 26, 26, 0.35);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 16px 16px;
  }
  .search-modal.hidden {
    display: none;
  }
  .search-panel {
    position: relative;
    width: 100%;
    max-width: 620px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-top: 2px solid var(--fg);
    border-radius: 2px;
    padding: 18px 16px 12px;
    font-family: var(--serif);
  }
  .search-close {
    position: absolute;
    top: 10px;
    right: 8px;
    background: none;
    border: none;
    color: var(--muted);
    padding: 4px;
    cursor: pointer;
  }
  .search-close:hover {
    color: var(--fg);
  }
  .search-input {
    width: calc(100% - 32px);
    font-family: var(--serif);
    font-size: 16px;
    color: var(--fg);
    background: var(--bg);
    border: none;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 6px 2px 8px;
    margin: 0 0 4px;
    outline: none;
  }
  .search-input:focus {
    border-bottom: 1px solid var(--mark);
  }
  .search-results {
    max-height: 60vh;
    overflow-y: auto;
  }
  .search-empty {
    font-size: 13px;
    color: var(--muted);
    padding: 14px 2px;
  }
  .search-hit {
    display: block;
    padding: 12px 2px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
  }
  .search-hit:hover .search-hit-title {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-underline-offset: 3px;
  }
  .search-hit-title {
    display: block;
    font-size: 15.5px;
    color: var(--fg);
    margin-top: 4px;
  }
  .search-hit-desc,
  .search-hit-match {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 3px;
    overflow-wrap: anywhere;
  }
  .search-hit-tags {
    display: block;
    font-family: var(--sans);
    font-size: 11px;
    color: var(--accent);
    margin-top: 4px;
  }
  .search-results mark {
    background: none;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
</style>

<script>
  let searchData = []
  let searchInput
  let searchResults
  let searchModal
  let searchButton
  let closeButton
  let searchDebounceTimeout

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
  }

  function debounce(func, wait) {
    return (...args) => {
      clearTimeout(searchDebounceTimeout)
      searchDebounceTimeout = setTimeout(() => func(...args), wait)
    }
  }

  async function initialize() {
    const response = await fetch('/api/search.json')
    searchData = await response.json()

    searchInput = document.getElementById('search-input')
    searchResults = document.getElementById('search-results')
    searchModal = document.getElementById('search-modal')
    searchButton = document.getElementById('search-button')
    closeButton = document.getElementById('close-search')

    // ヘッダーは backdrop-filter を持つので、その中の position: fixed はヘッダー基準になってしまう。
    // モーダルは body 直下へ移して画面全体に被せる。
    if (searchModal && searchModal.parentElement !== document.body) {
      document.body.appendChild(searchModal)
    }

    const debouncedSearch = debounce(handleSearch, 300)
    searchInput?.addEventListener('input', debouncedSearch)
    searchButton?.addEventListener('click', openModal)
    closeButton?.addEventListener('click', closeModal)

    // Close modal on outside click
    searchModal?.addEventListener('click', (e) => {
      if (e.target === searchModal) {
        closeModal()
      }
    })

    // Close modal on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
        closeModal()
      }
    })

    // Cleanup function
    return () => {
      clearTimeout(searchDebounceTimeout)
    }
  }

  function openModal() {
    searchModal?.classList.remove('hidden')
    searchInput?.focus()
  }

  function closeModal() {
    searchModal?.classList.add('hidden')
    searchInput.value = ''
    searchResults.innerHTML = `<div class="search-empty">見つかりませんでした</div>`
  }

  function highlightText(text, query) {
    if (!query) return text
    // 正規表現の記号（( や + など）を含む語でも落ちないようエスケープする
    const escaped = escapeHtml(query).replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
    const regex = new RegExp(`(${escaped})`, 'gi')
    return text.replace(regex, '<mark>$1</mark>')
  }

  function handleSearch(e) {
    const query = e.target.value.toLowerCase()

    if (!query) {
      searchResults.innerHTML = `<div class="search-empty">見つかりませんでした</div>`
      return
    }

    const results = searchData
      .filter((post) => {
        const searchContent = `${post.title} ${post.description} ${post.content} ${post.tags?.join(' ')}`.toLowerCase()
        return searchContent.includes(query)
      })
      .map((post) => {
        // Find content match
        const contentMatch = post.content.toLowerCase().indexOf(query.toLowerCase())
        let matchedContent = ''
        if (contentMatch !== -1) {
          const start = Math.max(0, contentMatch - 50)
          const end = Math.min(post.content.length, contentMatch + query.length + 50)
          matchedContent = post.content.slice(start, end)
          if (start > 0) matchedContent = '...' + matchedContent
          if (end < post.content.length) matchedContent = matchedContent + '...'
        }

        // Highlight matches in title and content (escape before highlighting)
        const highlightedTitle = highlightText(escapeHtml(post.title), query)
        const highlightedContent = highlightText(escapeHtml(matchedContent), query)

        return {
          ...post,
          matchedContent: highlightedContent,
          matchedTitle: highlightedTitle,
        }
      })
      .slice(0, 5)

    displayResults(results)
  }

  function generatePostUrl(post) {
    switch (post.collection) {
      case 'blog':
        return `/blog/${post.slug}`
      case 'diary':
        const date = new Date(post.date)
        const jstDate = new Date(date.toLocaleString('en-US', { timeZone: 'Asia/Tokyo' }))
        const year = jstDate.getFullYear()
        const month = String(jstDate.getMonth() + 1).padStart(2, '0')
        const day = String(jstDate.getDate()).padStart(2, '0')
        return `/diary/${year}/${month}/${day}`
      case 'emonicle':
        return `/emonicle/${post.slug}`
      default:
        return `/blog/${post.slug}`
    }
  }

  function displayResults(results) {
    if (results.length === 0) {
      searchResults.innerHTML = `<div class="search-empty">見つかりませんでした</div>`
    } else {
      const labels = { blog: 'BLOG', diary: 'DIARY', emonicle: 'EMONICLE' }
      searchResults.innerHTML = results
        .map(
          (post) => `
            <a href="${generatePostUrl(post)}" class="search-hit">
              <span class="now-tag">${labels[post.collection] || 'BLOG'}</span>
              <span class="search-hit-title">${post.matchedTitle || escapeHtml(post.title)}</span>
              ${post.description ? `<span class="search-hit-desc">${escapeHtml(post.description)}</span>` : ''}
              ${post.matchedContent ? `<span class="search-hit-match">${post.matchedContent}</span>` : ''}
              ${post.tags && post.tags.length > 0
                ? `<span class="search-hit-tags">${post.tags.map((tag) => escapeHtml(tag)).join('・')}</span>`
                : ''}
            </a>
          `
        )
        .join('')
    }

    searchResults.classList.remove('hidden')
  }

  // Initialize search functionality
  document.addEventListener('DOMContentLoaded', initialize)
</script>
