---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchAllBlogs } from '../lib/content';
import { filterPublishedPosts, sortPostsByDate } from '../utils/posts';
import PostDate from '../components/PostDate.astro';
import { getDateParts } from '../utils/date';

const posts = await fetchAllBlogs();
const publishedPosts = filterPublishedPosts(posts);
const sortedPosts = sortPostsByDate(publishedPosts);

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = Number(getDateParts(post.data.date).year);
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {} as Record<number, typeof sortedPosts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Archive">
  <h1 class="page-title">Archive</h1>
  <p class="page-lead">ブログの記事を年ごとに</p>

  {years.map((year, i) => (
    <section>
      <h2 class:list={['section-head', { 'is-first': i === 0 }]}>{year}</h2>
      <ul class="plainlist archive-list">
        {postsByYear[year].map(post => (
          <li>
            <PostDate date={post.data.date} class="archive-date" />
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .archive-list li {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }
  .archive-list :global(.archive-date) {
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .archive-list a {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .section-head.is-first {
    margin-top: 28px;
  }
</style>
