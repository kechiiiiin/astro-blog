---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import { fetchAllBlogs } from '../../lib/content';
import { getAllTags, getPostsByTag, sortPostsByDate } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await fetchAllBlogs();
  const tags = getAllTags(posts);

  return tags.map((tag) => {
    const filteredPosts = getPostsByTag(posts, tag);
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const sortedPosts = sortPostsByDate(posts);
---

<BaseLayout title={`Posts tagged with #${tag}`}>
  <a class="back-btn" href="/tags/">‹ タグ一覧へ</a>
  <p class="now-tag">TAG</p>
  <h1 class="page-title">{tag}</h1>
  <p class="page-lead">{sortedPosts.length}件の記事</p>
  <section class="row-list">
    {sortedPosts.map((post) => (
      <ListRow
        href={`/blog/${post.id}`}
        title={post.data.title}
        date={post.data.date}
        desc={post.data.description}
        tags={post.data.tags}
      />
    ))}
  </section>
</BaseLayout>
