---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllBlogs } from '../../lib/content';
import { getAllTags, getPostsByTag } from '../../utils/posts';

const posts = await fetchAllBlogs();
const tags = getAllTags(posts);
const tagCounts = tags.map(tag => ({
  name: tag,
  count: getPostsByTag(posts, tag).length
})).sort((a, b) => b.count - a.count);
---

<BaseLayout title="Tags">
  <h1 class="page-title">Tags</h1>
  <p class="page-lead">ブログのタグ</p>
  <ul class="plainlist tag-list">
    {tagCounts.map(({ name, count }) => (
      <li>
        <a href={`/tags/${name}`}>{name}</a><span class="desc">{count}件</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .tag-list {
    border-top: 2px solid var(--fg);
  }
</style>
