---
import BaseLayout from '../layouts/BaseLayout.astro'
import { fetchAllBlogs, fetchAllDiaries } from '../lib/content'
import { filterPosts, filterDiaries } from '../utils/posts'
import { fetchAllPodcastFeeds } from '../utils/podcast'
import { fetchLatestBook } from '../utils/nobu'
import { formatDisplayDate, getDiaryPath } from '../utils/date'
import { siteConfig } from '../config'

// トップは「いまの けちーん」が分かる入口（2026-09 リニューアル・モック準拠）。
// 以前は src/content/home/index.mdx を描画していたが、紹介文・サイトマップはモックどおりここに置く
// （index.mdx 自体は残してある。PodcastArtworks を import しているのでそちらも残す）。
const [posts, diaryEntries] = await Promise.all([
  fetchAllBlogs(),
  fetchAllDiaries(),
]);

const [latestDiary] = filterDiaries(diaryEntries, { maxEntries: 1 })
const [latestPost] = filterPosts(posts, { maxPosts: 1 })

// ポッドキャストはビルド時に LISTEN の RSS から各番組の最新回を取る。
// 取れなかったときはトップを落とさず、その番組の行を出さない（/podcasts 側は従来どおり）。
let podcastLatest: { label: string; title: string; url: string; date: Date }[] = []
try {
  const feeds = await fetchAllPodcastFeeds()
  podcastLatest = feeds.flatMap(({ config, feed }) => {
    const ep = feed.episodes[0]
    return ep ? [{ label: config.label, title: ep.title, url: ep.episodeUrl, date: ep.pubDate }] : []
  })
} catch (e) {
  console.warn('[index] podcast RSS の取得に失敗したため「いま」から外します', e)
}

// 読書は NoBu の公開 JSON から最新の出来事1件（保留を除く）。取れなければ BOOK 行を出さない
const latestBook = await fetchLatestBook()
// 版元ドットコムの書籍ページへ（新しいタブ）。ISBN が無い本はリンクにしない
const BookRow = latestBook?.url ? 'a' : 'div'
const bookRowAttrs = latestBook?.url ? { href: latestBook.url, target: '_blank', rel: 'noopener noreferrer' } : {}

const sitemap = [
  { href: '/profile/', text: 'プロフィール', desc: '自己紹介' },
  { href: '/diary/', text: '日記', desc: '日々の記録' },
  { href: '/blog/', text: 'ブログ', desc: '技術記事や日記ではない文章' },
  { href: '/podcasts/', text: 'Podcast', desc: 'いくつか配信中' },
]
---

<BaseLayout title={siteConfig.title}>
  <h1 class="hero-name">けちーん</h1>
  <p class="hero-sub">日記を書いたり、ブログを書いたり、自由に書いていくサイト。<br>普段はエンジニアリングマネージャー、休みの日は山登りとラジオ収録をしています。</p>
  <div class="hero-links">
    {siteConfig.social.x && (
      <a href={siteConfig.social.x} target="_blank" rel="noopener noreferrer">X (@kechiiin_)</a>
    )}
    <a href="/profile/">プロフィール →</a>
  </div>

  <h2 class="section-head is-first">いま</h2>

  {latestDiary && (
    <a class="now-row" href={getDiaryPath(latestDiary.data.date)}>
      <div class="now-left">
        <span class="now-tag">DIARY</span>
        <span class="now-title">{latestDiary.data.title}</span>
        {latestDiary.data.description && <span class="now-desc">{latestDiary.data.description}</span>}
      </div>
      <span class="now-date">{formatDisplayDate(latestDiary.data.date)}</span>
    </a>
  )}

  {latestPost && (
    <a class="now-row" href={`/blog/${latestPost.id}`}>
      <div class="now-left">
        <span class="now-tag">BLOG</span>
        <span class="now-title">{latestPost.data.title}</span>
        {latestPost.data.description && <span class="now-desc">{latestPost.data.description}</span>}
      </div>
      <span class="now-date">{formatDisplayDate(latestPost.data.date)}</span>
    </a>
  )}

  {podcastLatest.map((ep) => (
    <a class="now-row" href={ep.url} target="_blank" rel="noopener noreferrer">
      <div class="now-left">
        <span class="now-tag">PODCAST・{ep.label}</span>
        <span class="now-title">{ep.title}</span>
      </div>
      <span class="now-date">{formatDisplayDate(ep.date)}</span>
    </a>
  ))}

  {latestBook && (
    <BookRow class="now-row is-book" {...bookRowAttrs}>
      {latestBook.cover && <img class="now-cover" src={latestBook.cover} alt="" height="48" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
      <div class="now-left">
        <span class="now-tag">BOOK・{latestBook.label}</span>
        <span class="now-title">{latestBook.title}</span>
        {latestBook.author && <span class="now-desc">{latestBook.author}</span>}
      </div>
      <span class="now-date">{formatDisplayDate(latestBook.date)}</span>
    </BookRow>
  )}

  <h2 class="section-head">サイトマップ</h2>
  <ul class="plainlist sitemap-list">
    {sitemap.map(({ href, text, desc }) => (
      <li><a href={href}>{text}<span class="desc">{desc}</span></a></li>
    ))}
  </ul>
</BaseLayout>
