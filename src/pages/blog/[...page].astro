---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchAllBlogs } from '../../lib/content';
import { filterPublishedPosts, sortPostsByDate } from '../../utils/posts';

export async function getStaticPaths({ paginate }) {
  const posts = await fetchAllBlogs();
  const publishedPosts = filterPublishedPosts(posts);
  const sortedPosts = sortPostsByDate(publishedPosts);

  return paginate(sortedPosts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Blog Posts">
  <h1 class="page-title">ブログ</h1>
  <section class="row-list">
    {page.data.map((post) => (
      <ListRow
        href={`/blog/${post.id}`}
        title={post.data.title}
        date={post.data.date}
        desc={post.data.description}
        tags={post.data.tags}
      />
    ))}
  </section>
  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/blog/"
  />
</BaseLayout>
