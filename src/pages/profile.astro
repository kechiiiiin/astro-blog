---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

// Load profile content from Markdown
const profileEntry = await getEntry('profile', 'index');
const { Content } = await profileEntry.render();
---

<BaseLayout title="Profile">
  <h1 class="text-4xl font-bold mb-8 text-gray-900">Profile</h1>

  <!-- Markdown content -->
  <div class="bg-gray-100 rounded-lg p-6 prose prose-lg
    prose-headings:text-gray-900
    prose-p:text-gray-700
    prose-a:text-blue-600
    hover:prose-a:text-blue-500
    prose-strong:text-gray-900
    prose-code:text-gray-300
    prose-blockquote:text-gray-700
    prose-span:text-gray-700
    prose-li:text-gray-700
    max-w-none">
    <Content />
  </div>
</BaseLayout>
