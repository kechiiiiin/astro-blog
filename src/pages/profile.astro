---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry } from 'astro:content';

// Load profile content from Markdown
const profileEntry = await getEntry('profile', 'index');
const { Content } = await profileEntry.render();
---

<BaseLayout title="Profile">
  <h1 class="page-title">Profile</h1>

  <div class="prose prose-lg max-w-none article-body profile-body">
    <Content />
  </div>
</BaseLayout>

<style>
  .profile-body {
    margin-top: 20px;
  }
  /* 写真は幅いっぱいにせず 360px まで（モックの .profile-photo） */
  .profile-body :global(img) {
    max-width: 360px;
    margin: 0.6em 0 1.6em;
  }
</style>
