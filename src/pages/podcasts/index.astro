---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchAllPodcastFeeds, formatDuration, stripHtml } from '../../utils/podcast';
import { formatDisplayDate } from '../../utils/date';

const allFeeds = await fetchAllPodcastFeeds();

function summary(description: string): string {
  const plain = stripHtml(description);
  return plain.length > 100 ? `${plain.slice(0, 100)}...` : plain;
}
---

<BaseLayout title="Podcast" description="ポッドキャスト一覧">
  <h1 class="page-title">Podcast</h1>
  <p class="page-lead">いくつか配信中。</p>

  <!-- 各番組の最新回（モックの Podcast タブ） -->
  <section class="podcast-latest">
    {allFeeds.map(({ config, feed }) => {
      const latest = feed.episodes[0];
      return (
        <div class="now-row is-top">
          <div class="now-left">
            <span class="now-tag">{config.label}</span>
            {latest ? (
              <a class="now-title podcast-title-link" href={latest.episodeUrl} target="_blank" rel="noopener noreferrer">{latest.title}</a>
            ) : (
              <span class="now-title">まだ配信がありません</span>
            )}
            <span class="now-desc">
              <a href={feed.channel.link} target="_blank" rel="noopener noreferrer">{config.linkText} →</a>
            </span>
          </div>
          {latest && <span class="now-date">{formatDisplayDate(latest.pubDate)}</span>}
        </div>
      );
    })}
  </section>

  <h2 class="section-head">すべての回</h2>
  <div role="tablist" class="tabs" aria-label="番組">
    {allFeeds.map(({ config }, index) => (
      <button
        role="tab"
        aria-selected={index === 0 ? 'true' : 'false'}
        aria-controls={`panel-${index}`}
        id={`tab-${index}`}
        data-tab-index={index}
        tabindex={index === 0 ? 0 : -1}
      >
        {config.label}
      </button>
    ))}
  </div>

  {allFeeds.map(({ config, feed }, index) => (
    <div
      role="tabpanel"
      id={`panel-${index}`}
      aria-labelledby={`tab-${index}`}
      hidden={index !== 0}
    >
      <div class="podcast-channel">
        {feed.channel.image && (
          <img src={feed.channel.image} alt="" class="podcast-art" loading="lazy" />
        )}
        <div class="podcast-channel-text">
          <p class="podcast-channel-desc">{feed.channel.description}</p>
          <a class="podcast-channel-link" href={feed.channel.link} target="_blank" rel="noopener noreferrer">{config.linkText} →</a>
        </div>
      </div>

      {feed.episodes.map((episode) => (
        <a class="now-row is-top" href={episode.episodeUrl} target="_blank" rel="noopener noreferrer">
          <div class="now-left">
            <span class="now-title">{episode.title}</span>
            {(episode.duration || episode.description) && (
              <span class="now-desc">
                {episode.duration && <span class="podcast-duration">{formatDuration(episode.duration)}</span>}
                {summary(episode.description)}
              </span>
            )}
          </div>
          <span class="now-date">{formatDisplayDate(episode.pubDate)}</span>
        </a>
      ))}
    </div>
  ))}

  <script>
    const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const panels = document.querySelectorAll<HTMLDivElement>('[role="tabpanel"]');

    function select(tab: HTMLButtonElement) {
      tabs.forEach((t) => {
        const selected = t === tab;
        t.setAttribute('aria-selected', selected ? 'true' : 'false');
        t.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.id !== `panel-${tab.dataset.tabIndex}`;
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
        next.focus();
      });
    });
  </script>
</BaseLayout>

<style>
  .podcast-title-link {
    text-decoration: none;
  }
  .podcast-title-link:hover {
    text-decoration: underline;
    text-decoration-color: var(--mark);
    text-underline-offset: 3px;
  }
  .section-head {
    margin-bottom: 0;
  }
  .tabs {
    margin-top: 12px;
  }
  .podcast-channel {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 2px;
    border-bottom: 1px solid var(--line);
  }
  .podcast-art {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 2px;
    border: 1px solid var(--line);
  }
  .podcast-channel-text {
    min-width: 0;
  }
  .podcast-channel-desc {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .podcast-channel-link {
    font-family: var(--sans);
    font-size: 12px;
    color: var(--accent);
  }
  .podcast-duration {
    font-family: var(--sans);
    font-size: 11px;
    margin-right: 8px;
  }
</style>
