---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchAllDiaries } from '../../lib/content';
import { sortDiariesByDate, filterPublishedDiaries } from '../../utils/posts';
import { getDateParts, getDiaryPath } from '../../utils/date';

export async function getStaticPaths({ paginate }) {
  const entries = await fetchAllDiaries();
  const publishedEntries = filterPublishedDiaries(entries);
  const sortedEntries = sortDiariesByDate(publishedEntries);

  return paginate(sortedEntries, { pageSize: 10 });
}

const { page } = Astro.props;

// かけら帳 KatachiListScreen 準拠の見た目（月見出し＋日付行）。行の意匠はサイト共通の ListRow。
function monthHeading(year: string, month: string): string {
  return `${year}年${parseInt(month, 10)}月`;
}

const groups: { heading: string; entries: typeof page.data }[] = [];
for (const entry of page.data) {
  const { year, month } = getDateParts(entry.data.date);
  const heading = monthHeading(year, month);
  let group = groups[groups.length - 1];
  if (!group || group.heading !== heading) {
    group = { heading, entries: [] };
    groups.push(group);
  }
  group.entries.push(entry);
}
---

<BaseLayout title="Diary">
  <h1 class="page-title">日記</h1>

  {groups.map((group, i) => (
    <section>
      <h2 class:list={['month-head', { 'is-first': i === 0 }]}>{group.heading}</h2>
      {group.entries.map((entry) => (
        <ListRow
          href={getDiaryPath(entry.data.date)}
          title={entry.data.title}
          date={entry.data.date}
          desc={entry.data.description}
          image={entry.data.image}
          descBelow
        />
      ))}
    </section>
  ))}

  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/diary/"
  />
</BaseLayout>
