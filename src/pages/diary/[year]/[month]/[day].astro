---
import { fetchAllDiaries } from '../../../../lib/content';
import DiaryPost from '../../../../layouts/DiaryPost.astro';
import { getDateParts, matchesDateParts, isPublished } from '../../../../utils/date';

export async function getStaticPaths() {
  // 下書き・未来日も含めて全件ページ化（URL直アクセスでプレビュー可能に）。
  const entries = await fetchAllDiaries();

  return entries.map((entry) => {
    const { year, month, day } = getDateParts(entry.data.date);

    return {
      params: { year, month, day },
      props: { entry },
    };
  });
}

const { year, month, day } = Astro.params;
const { entry } = Astro.props;

// Validate that the entry matches the date
if (!matchesDateParts(entry.data.date, { year, month, day })) {
  return Astro.redirect('/404');
}

const { Content } = await entry.render();

// microCMSのコンテンツはHTMLとして返される
const isMicroCMS = entry.source === 'microcms';
const htmlContent = isMicroCMS ? Content() : null;

const preview = Boolean(entry.data.draft) || !isPublished(entry.data.date);
---

<DiaryPost entry={entry} preview={preview}>
  {isMicroCMS ? (
    <div set:html={htmlContent} class="microcms-content" />
  ) : (
    <Content />
  )}
</DiaryPost>

<style>
  /* microCMSのHTMLコンテンツのスタイリング */
  :global(.microcms-content p) {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  :global(.microcms-content p:last-child) {
    margin-bottom: 0;
  }

  /* 空の段落も高さを持つようにする */
  :global(.microcms-content p:empty),
  :global(.microcms-content p:has(> br:only-child)) {
    min-height: 1em;
  }
</style>