---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListRow from '../../components/ListRow.astro';
import Pagination from '../../components/Pagination.astro';
import { fetchAllEmonicles } from '../../lib/content';
import { filterPublishedEmonicles, sortEmoniclesByDate } from '../../utils/posts';

export async function getStaticPaths({ paginate }) {
  const posts = await fetchAllEmonicles();
  const publishedPosts = filterPublishedEmonicles(posts);
  const sortedPosts = sortEmoniclesByDate(publishedPosts);

  return paginate(sortedPosts, { pageSize: 10 });
}

const { page } = Astro.props;
---

<BaseLayout title="Emonicle Posts">
  <h1 class="page-title">Emonicle</h1>
  <p class="page-lead">emonicleはemotionとchronicleを合わせた造語です<br>そのときに感じた、ありのままの感情を書き留める場所です</p>
  <section class="row-list">
    {page.data.map((post) => (
      <ListRow
        href={`/emonicle/${post.id}`}
        title={post.data.title}
        date={post.data.date}
        desc={post.data.description}
      />
    ))}
  </section>
  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    baseUrl="/emonicle/"
  />
</BaseLayout>
