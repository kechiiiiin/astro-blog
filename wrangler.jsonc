{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-blog",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./dist",
    // 存在しないパスでは Astro が生成する dist/404.html を返す。
    // 既定は "none" で、その場合は中身が空の 404 になる（Vercel は自動で
    // 404.html を返していたため、移行時にこの挙動が失われていた）。
    "not_found_handling": "404-page"
  },

  // プレビュー URL（astro-blog.kechiiiiin.workers.dev）を維持する。
  // routes を書くと既定で無効化されるため明示的に有効化しておく。
  "workers_dev": true,

  // 本番ドメイン。カスタムドメインではなく **Worker ルート** を使う。
  //   経緯: 移行時、www は CNAME → cname.vercel-dns.com（プロキシ済み）のままだった。
  //   カスタムドメイン方式は既存 DNS の削除を要求され、その間ダウンするため不採用
  //   （実際に "already has externally managed DNS records" で拒否された）。
  //   Worker ルートなら Cloudflare のエッジで先に応答するので、DNS を触らず移行できた。
  // 2026-08-01: Vercel を廃止し、www も apex と同じ A 192.0.2.1（プロキシ済み）に変更。
  //   この 192.0.2.1 は RFC 5737 のドキュメント用アドレスで、実際には接続されない。
  //   ⚠️ 配信しているのはこの routes だけ。**消すとサイトが落ちる**（戻り先の Vercel はもう無い）。
  "routes": [
    { "pattern": "www.kechiiiiin.com/*", "zone_name": "kechiiiiin.com" }
  ]
}
