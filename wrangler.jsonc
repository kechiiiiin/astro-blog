{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astro-blog",
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./dist",
    // 存在しないパスでは Astro が生成する dist/404.html を返す。
    // 既定は "none" で、その場合は中身が空の 404 になる（Vercel は自動で
    // 404.html を返していたため、移行時にこの挙動が失われていた）。
    "not_found_handling": "404-page"
  },

  // プレビュー URL（astro-blog.kechiiiiin.workers.dev）を維持する。
  // routes を書くと既定で無効化されるため明示的に有効化しておく。
  "workers_dev": true,

  // 本番ドメイン。カスタムドメインではなく **Worker ルート** を使う。
  //   理由: www は CNAME → cname.vercel-dns.com（プロキシ済み）のまま。
  //   Cloudflare のエッジで Worker が先に応答するので Vercel には届かない。
  //   カスタムドメイン方式は既存 DNS の削除を要求され、その間ダウンするため不採用
  //   （実際に "already has externally managed DNS records" で拒否された）。
  // 切り戻し: この routes を消して deploy すれば、DNS はそのままなので即 Vercel に戻る。
  "routes": [
    { "pattern": "www.kechiiiiin.com/*", "zone_name": "kechiiiiin.com" }
  ]
}
